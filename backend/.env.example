# Copy this file to `.env` and replace placeholders with local values.
# Never commit `.env` or real secrets.

# PostgreSQL (currently loaded by database.py)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Groq LLM (currently loaded by analyzer.py and routers.py)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase (currently loaded by rag.py for vector/RAG search)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# CORS allowlist for a later config-driven origins change (comma-separated).
# The API currently hardcodes origins in main.py; this is the planned contract.
ALLOWED_ORIGINS=http://localhost:5173

# Application log level (planned logging contract; not yet read by the app)
LOG_LEVEL=INFO

# Clerk — planned server-side authentication phase (not wired in the backend yet)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
